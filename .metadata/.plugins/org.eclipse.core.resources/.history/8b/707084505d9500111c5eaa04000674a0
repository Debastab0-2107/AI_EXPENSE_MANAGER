package com.expensemanager.controller;

import java.math.BigDecimal;

import org.springframework.http.ContentDisposition;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.expensemanager.dto.AIFinancialReportData;
import com.expensemanager.dto.AIInsightRequest;
import com.expensemanager.dto.AIInsightResponse;
import com.expensemanager.dto.ApiResponse;
import com.expensemanager.dto.BudgetVsActualResponse;
import com.expensemanager.dto.MonthlyReportResponse;
import com.expensemanager.service.AIInsightService;
import com.expensemanager.service.PDFService;
import com.expensemanager.service.ReportService;

@RestController
@RequestMapping("/api/ai-insights")
public class AIFinancialReportController {

    private final PDFService pdfService;
    private final ReportService reportService;
    private final AIInsightService aiInsightService;

    public AIFinancialReportController(
            PDFService pdfService,
            ReportService reportService,
            AIInsightService aiInsightService) {

        this.pdfService = pdfService;
        this.reportService = reportService;
        this.aiInsightService = aiInsightService;
    }

    @GetMapping("/monthly/pdf")
    public ResponseEntity<byte[]> downloadMonthlyAIReport(
            @RequestParam int month,
            @RequestParam int year) {

        // =====================================================
        // 1. GET MONTHLY FINANCIAL DATA
        // =====================================================

        ApiResponse<MonthlyReportResponse> monthlyResponse =
                reportService.getMonthlyReport(month, year);

        MonthlyReportResponse monthly =
                monthlyResponse.getData();

        BigDecimal income =
                monthly.getIncome();

        BigDecimal expense =
                monthly.getExpense();

        BigDecimal savings =
                income.subtract(expense);


        // =====================================================
        // 2. GET BUDGET DATA
        // =====================================================

        ApiResponse<BudgetVsActualResponse> budgetResponse =
                reportService.getBudgetVsActual(month, year);

        BudgetVsActualResponse budgetData =
                budgetResponse.getData();

        BigDecimal budget =
                budgetData.getTotalBudget();

        BigDecimal unusedBudget =
                budgetData.getRemaining();

        BigDecimal expenseRate =
                BigDecimal.ZERO;

        BigDecimal savingsRate =
                BigDecimal.ZERO;

        if (income.compareTo(BigDecimal.ZERO) > 0) {

            expenseRate =
                    expense
                            .divide(
                                    income,
                                    4,
                                    java.math.RoundingMode.HALF_UP)
                            .multiply(BigDecimal.valueOf(100))
                            .setScale(
                                    2,
                                    java.math.RoundingMode.HALF_UP);

            savingsRate =
                    savings
                            .divide(
                                    income,
                                    4,
                                    java.math.RoundingMode.HALF_UP)
                            .multiply(BigDecimal.valueOf(100))
                            .setScale(
                                    2,
                                    java.math.RoundingMode.HALF_UP);
        }


        // =====================================================
        // 3. BUDGET STATUS
        // =====================================================

        String budgetStatus;

        if (budgetData.isExceeded()) {

            budgetStatus =
                    "Expenses Exceed Budget";

        } else {

            budgetStatus =
                    "Expenses Within Budget";
        }


        // =====================================================
        // 4. GET AI INSIGHTS
        // =====================================================

        AIInsightRequest aiRequest =
                new AIInsightRequest();

        aiRequest.setMonth(month);
        aiRequest.setYear(year);

        ApiResponse<AIInsightResponse> aiResponse =
                aiInsightService.generateInsights(aiRequest);

        AIInsightResponse ai =
                aiResponse.getData();


        // =====================================================
        // 5. CREATE PDF DATA
        // =====================================================

        AIFinancialReportData data =
                new AIFinancialReportData();

        data.setMonth(month);
        data.setYear(year);

        data.setIncome(income);
        data.setExpense(expense);
        data.setSavings(savings);
        data.setBudget(budget);

        data.setSavingsRate(savingsRate);
        data.setExpenseRate(expenseRate);
        data.setUnusedBudget(unusedBudget);

        data.setBudgetStatus(budgetStatus);


        // =====================================================
        // 6. AI CONTENT
        // =====================================================

        if (ai != null) {

            data.setFinancialOverview(
                    ai.getSummary());

            data.setSpendingAnalysis(
                    ai.getSummary());

            data.setSavingsPerformance(
                    getInsight(ai, 0));

            data.setBudgetPosition(
                    getInsight(ai, 1));

            data.setSpendingBehaviour(
                    getInsight(ai, 2));

            data.setFinancialDirection(
                    getInsight(ai, 3));

            data.setSavingsDescription(
                    ai.getSummary());

            data.setRecommendation(
                    getRecommendation(ai));
        }


        // =====================================================
        // 7. GENERATE PDF
        // =====================================================

        byte[] pdf =
                pdfService.generateAIFinancialReport(data);


        // =====================================================
        // 8. RESPONSE
        // =====================================================

        HttpHeaders headers =
                new HttpHeaders();

        headers.setContentType(
                MediaType.APPLICATION_PDF);

        headers.setContentDisposition(
                ContentDisposition
                        .attachment()
                        .filename(
                                "CashCompass-AI-Financial-Report.pdf")
                        .build());

        headers.setContentLength(
                pdf.length);

        return ResponseEntity
                .ok()
                .headers(headers)
                .body(pdf);
    }


    // =====================================================
    // HELPER: GET AI INSIGHT
    // =====================================================

    private String getInsight(
            AIInsightResponse ai,
            int index) {

        if (ai.getInsights() == null) {
            return "";
        }

        if (ai.getInsights().size() <= index) {
            return "";
        }

        return ai.getInsights().get(index);
    }


    // =====================================================
    // HELPER: GET AI RECOMMENDATION
    // =====================================================

    private String getRecommendation(
            AIInsightResponse ai) {

        if (ai.getRecommendations() == null) {
            return "";
        }

        if (ai.getRecommendations().isEmpty()) {
            return "";
        }

        return ai.getRecommendations().get(0);
    }
}