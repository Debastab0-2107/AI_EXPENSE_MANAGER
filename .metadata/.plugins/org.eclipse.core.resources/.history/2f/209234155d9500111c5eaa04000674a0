package com.expensemanager.controller;

import java.math.BigDecimal;

import org.springframework.http.ContentDisposition;
import org.springframework.http.HttpHeaders;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.expensemanager.dto.AIFinancialReportData;
import com.expensemanager.service.PDFService;

@RestController
@RequestMapping("/api/ai-insights")
public class AIFinancialReportController {

    private final PDFService pdfService;

    public AIFinancialReportController(
            PDFService pdfService) {

        this.pdfService = pdfService;
    }

    @GetMapping("/monthly/pdf")
    public ResponseEntity<byte[]>
            downloadMonthlyAIReport(
                    @RequestParam int month,
                    @RequestParam int year) {

        /*
         * TEMPORARY test data.
         *
         * We will connect this to the real
         * AI/report service after confirming
         * PDF rendering works.
         */

        AIFinancialReportData data =
                new AIFinancialReportData();

        data.setMonth(month);
        data.setYear(year);

        data.setIncome(
                new BigDecimal("50000"));

        data.setExpense(
                new BigDecimal("32000"));

        data.setSavings(
                new BigDecimal("18000"));

        data.setBudget(
                new BigDecimal("40000"));

        data.setSavingsRate(
                new BigDecimal("36"));

        data.setExpenseRate(
                new BigDecimal("64"));

        data.setUnusedBudget(
                new BigDecimal("8000"));

        byte[] pdf =
                pdfService.generateAIFinancialReport(
                        data);

        HttpHeaders headers =
                new HttpHeaders();

        headers.setContentType(
                MediaType.APPLICATION_PDF);

        headers.setContentDisposition(
                ContentDisposition
                        .attachment()
                        .filename(
                                "CashCompass-AI-Financial-Report.pdf")
                        .build());

        headers.setContentLength(
                pdf.length);

        return ResponseEntity
                .ok()
                .headers(headers)
                .body(pdf);
    }
}