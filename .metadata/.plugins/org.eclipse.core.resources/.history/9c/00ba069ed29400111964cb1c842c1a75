<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>CashCompass — AI Financial Report</title>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <style>

        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        body {

            font-family:
                "Segoe UI",
                Arial,
                Helvetica,
                sans-serif;

            background: #eeeeee;

            color: #202020;

            padding: 30px;
        }


        /* =====================================================
           REPORT PAGE
        ===================================================== */

        .report {

            width: 100%;

            max-width: 1050px;

            margin: auto;

            background: #ffffff;

            padding: 45px 55px;

            box-shadow:
                0 10px 35px rgba(0, 0, 0, 0.10);
        }


        /* =====================================================
           COMPANY HEADER
        ===================================================== */

        .company-header {

            display: flex;

            justify-content: space-between;

            align-items: center;

            padding-bottom: 18px;

            border-bottom: 1px solid #222;
        }


        /* COMPANY BRAND */

        .company-brand {

            display: flex;

            align-items: center;

            gap: 12px;
        }


        /* LOGO */

        .company-logo {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    background: transparent;
}

.company-logo img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    display: block;
}


        /* COMPANY NAME */

        .company-name {

            font-size: 22px;

            font-weight: 900;

            letter-spacing: -0.8px;

            color: #222;
        }


        /* TAGLINE */

        .company-tagline {

            margin-top: 2px;

            font-size: 10px;

            letter-spacing: 0.4px;

            color: #777;

            font-style: italic;
        }


        /* REPORT TYPE */

        .report-type {

            text-align: right;
        }


        .report-label {

            font-size: 11px;

            font-weight: 900;

            letter-spacing: 1.2px;

            color: #222;
        }


        .report-period {

            margin-top: 4px;

            font-size: 8px;

            color: #999;

            letter-spacing: 0.7px;
        }


        /* =====================================================
           REPORT HEADER
        ===================================================== */

        .report-header {

            display: grid;

            grid-template-columns: 2fr 1fr;

            border-bottom: 1px solid #d8b72c;
        }


        /* REPORT TITLE */

        .report-title {

            padding: 28px 25px 28px 0;
        }


        .report-title h1 {

            font-size: 38px;

            line-height: 1;

            font-weight: 900;

            letter-spacing: -1.5px;

            text-transform: uppercase;
        }


        .report-title h1 span {

            display: block;

            color: #d3a900;
        }


        .report-title p {

            margin-top: 15px;

            max-width: 580px;

            font-size: 11px;

            line-height: 1.7;

            color: #777;
        }


        /* =====================================================
           AI STATUS
        ===================================================== */

        .ai-status {

            border-left: 1px solid #d8b72c;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            text-align: center;
        }


        .ai-circle {

            width: 48px;

            height: 48px;

            border-radius: 50%;

            background: #f5ca21;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 22px;

            margin-bottom: 7px;
        }


        .ai-status strong {

            font-size: 20px;

            color: #d3a900;
        }


        .ai-status span {

            font-size: 9px;

            color: #555;

            margin-top: 2px;

            letter-spacing: 0.5px;
        }


        /* =====================================================
           FINANCIAL SUMMARY
        ===================================================== */

        .summary {

            display: grid;

            grid-template-columns: 1fr 1fr 1fr;

            border-bottom: 1px solid #d8b72c;
        }


        .summary-box {

            min-height: 155px;

            padding: 25px 22px;

            border-right: 1px solid #e1d27b;
        }


        .summary-box:last-child {

            border-right: none;
        }


        .small-label {

            text-transform: uppercase;

            font-size: 10px;

            font-weight: 700;

            color: #777;

            letter-spacing: 0.7px;
        }


        .summary-number {

            font-size: 31px;

            font-weight: 800;

            margin-top: 8px;

            color: #222;
        }


        .summary-number.income {

            color: #159447;
        }


        .summary-number.expense {

            color: #c7463d;
        }


        .summary-number.savings {

            color: #d2a900;
        }


        .summary-text {

            font-size: 10px;

            line-height: 1.65;

            color: #777;

            margin-top: 8px;
        }


        /* =====================================================
           MAIN CONTENT
        ===================================================== */

        .main-grid {

            display: grid;

            grid-template-columns: 1.25fr 0.75fr;

            border-bottom: 1px solid #d8b72c;
        }


        .left-content {

            padding: 28px 25px 28px 0;

            border-right: 1px solid #d8b72c;
        }


        .right-content {

            padding: 28px 0 28px 25px;
        }


        /* =====================================================
           SECTION TITLE
        ===================================================== */

        .section-title {

            display: flex;

            align-items: center;

            gap: 10px;

            margin-bottom: 13px;
        }


        .section-title h2 {

            font-size: 17px;

            text-transform: uppercase;

            font-weight: 850;

            letter-spacing: -0.4px;
        }


        .section-line {

            height: 3px;

            width: 28px;

            background: #e0bb17;
        }


        /* =====================================================
           TEXT BLOCK
        ===================================================== */

        .text-block {

            margin-bottom: 28px;
        }


        .text-block p {

            font-size: 11px;

            line-height: 1.8;

            color: #555;

            text-align: justify;
        }


        .highlight {

            color: #d1a700;

            font-weight: 800;
        }


        /* =====================================================
           FINANCIAL BREAKDOWN
        ===================================================== */

        .breakdown {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 12px;

            margin-top: 18px;
        }


        .breakdown-item {

            border-top: 2px solid #222;

            padding-top: 10px;
        }


        .breakdown-item h3 {

            font-size: 12px;

            text-transform: uppercase;
        }


        .breakdown-item p {

            font-size: 10px;

            color: #777;

            line-height: 1.6;

            margin-top: 5px;
        }


        /* =====================================================
           PIE CHART
        ===================================================== */

        .chart-box {

            height: 210px;

            position: relative;

            margin-top: 10px;
        }


        .chart-box canvas {

            max-height: 210px;
        }


        /* =====================================================
           BUDGET SECTION
        ===================================================== */

        .budget-section {

            border-bottom: 1px solid #d8b72c;

            padding: 27px 0;
        }


        .budget-grid {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 25px;
        }


        .budget-text p {

            font-size: 11px;

            line-height: 1.8;

            color: #555;
        }


        .budget-status {

            margin-top: 15px;

            display: inline-block;

            padding: 7px 12px;

            background: #f7df65;

            font-size: 10px;

            font-weight: 800;

            text-transform: uppercase;
        }


        .bar-container {

            height: 190px;

            position: relative;
        }


        /* =====================================================
           AI INSIGHTS
        ===================================================== */

        .ai-section {

            padding: 30px 0;

            border-bottom: 1px solid #d8b72c;
        }


        .ai-grid {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 0;

            border-top: 1px solid #ddd;

            border-left: 1px solid #ddd;
        }


        .ai-card {

            padding: 20px;

            border-right: 1px solid #ddd;

            border-bottom: 1px solid #ddd;

            min-height: 135px;
        }


        .ai-card h3 {

            font-size: 12px;

            text-transform: uppercase;

            margin-bottom: 9px;

            display: flex;

            align-items: center;

            gap: 8px;
        }


        .ai-card p {

            font-size: 10px;

            line-height: 1.75;

            color: #666;
        }


        .ai-icon {

            width: 24px;

            height: 24px;

            background: #f4cd29;

            border-radius: 50%;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            font-size: 12px;
        }


        /* =====================================================
           SAVINGS RATE
        ===================================================== */

        .savings-section {

            display: grid;

            grid-template-columns: 170px 1fr;

            border-bottom: 1px solid #d8b72c;
        }


        .rate {

            border-right: 1px solid #d8b72c;

            padding: 25px;

            display: flex;

            flex-direction: column;

            justify-content: center;
        }


        .rate-number {

            font-size: 42px;

            font-weight: 900;

            color: #d0a800;
        }


        .rate-label {

            font-size: 10px;

            text-transform: uppercase;

            font-weight: 700;

            margin-top: 4px;
        }


        .rate-description {

            padding: 25px;
        }


        .rate-description h2 {

            font-size: 16px;

            margin-bottom: 8px;

            text-transform: uppercase;
        }


        .rate-description p {

            font-size: 10px;

            color: #666;

            line-height: 1.8;
        }


        /* =====================================================
           RECOMMENDATION
        ===================================================== */

        .recommendation {

            padding: 28px 0;

            display: grid;

            grid-template-columns: 50px 1fr;

            gap: 15px;
        }


        .quote {

            font-size: 45px;

            line-height: 0.7;

            color: #e0bd20;

            font-weight: 900;
        }


        .recommendation p {

            font-size: 12px;

            line-height: 1.8;

            color: #555;

            font-style: italic;
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .footer {

            display: flex;

            justify-content: space-between;

            align-items: center;

            border-top: 1px solid #222;

            padding-top: 15px;

            margin-top: 5px;
        }


        .footer strong {

            font-size: 13px;

            text-transform: uppercase;
        }


        .footer span {

            font-size: 9px;

            color: #777;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media(max-width: 750px) {

            body {

                padding: 10px;
            }


            .report {

                padding: 30px 25px;
            }


            .company-header {

                flex-direction: column;

                align-items: flex-start;

                gap: 15px;
            }


            .report-type {

                text-align: left;
            }


            .report-header {

                grid-template-columns: 1fr;
            }


            .report-title {

                padding-right: 0;
            }


            .ai-status {

                border-left: none;

                border-top: 1px solid #d8b72c;

                padding: 20px;
            }


            .summary {

                grid-template-columns: 1fr;
            }


            .summary-box {

                border-right: none;

                border-bottom: 1px solid #e1d27b;
            }


            .main-grid {

                grid-template-columns: 1fr;
            }


            .left-content {

                border-right: none;

                border-bottom: 1px solid #d8b72c;

                padding-right: 0;
            }


            .right-content {

                padding-left: 0;
            }


            .budget-grid {

                grid-template-columns: 1fr;
            }


            .ai-grid {

                grid-template-columns: 1fr;
            }


            .savings-section {

                grid-template-columns: 1fr;
            }


            .rate {

                border-right: none;

                border-bottom: 1px solid #d8b72c;
            }

        }


        /* =====================================================
           PRINT / PDF
        ===================================================== */

        @media print {

            body {

                background: white;

                padding: 0;
            }


            .report {

                max-width: none;

                box-shadow: none;

                padding: 35px;
            }

        }

    </style>

</head>


