<script>


/* =========================================================
   FINANCIAL DISTRIBUTION PIE / DOUGHNUT
========================================================= */

const pieContext =
    document
        .getElementById("pieChart")
        .getContext("2d");


new Chart(pieContext, {

    type: "doughnut",

    data: {

        labels: [
            "Expenses",
            "Savings"
        ],

        datasets: [

            {

                data: [
                    32000,
                    18000
                ],

                backgroundColor: [

                    "#222222",

                    "#e2bc16"

                ],

                borderWidth: 0

            }

        ]

    },

    options: {

        responsive: true,

        maintainAspectRatio: false,

        cutout: "68%",

        plugins: {

            legend: {

                position: "bottom",

                labels: {

                    boxWidth: 10,

                    padding: 15,

                    font: {

                        size: 10

                    }

                }

            },

            tooltip: {

                callbacks: {

                    label: function(context) {

                        return (
                            " ₹" +
                            context.raw.toLocaleString("en-IN")
                        );

                    }

                }

            }

        }

    }

});



/* =========================================================
   INCOME VS BUDGET BAR CHART
========================================================= */

const barContext =
    document
        .getElementById("barChart")
        .getContext("2d");


new Chart(barContext, {

    type: "bar",

    data: {

        labels: [

            "Income",

            "Budget",

            "Expenses"

        ],

        datasets: [

            {

                data: [

                    50000,

                    40000,

                    32000

                ],

                backgroundColor: [

                    "#e0bb17",

                    "#555555",

                    "#222222"

                ],

                borderRadius: 3,

                barThickness: 28

            }

        ]

    },

    options: {

        responsive: true,

        maintainAspectRatio: false,

        plugins: {

            legend: {

                display: false

            },

            tooltip: {

                callbacks: {

                    label: function(context) {

                        return (
                            " ₹" +
                            context.raw.toLocaleString("en-IN")
                        );

                    }

                }

            }

        },

        scales: {

            y: {

                beginAtZero: true,

                grid: {

                    color: "#eeeeee"

                },

                ticks: {

                    font: {

                        size: 9

                    },

                    callback: function(value) {

                        return (
                            "₹" +
                            (value / 1000) +
                            "k"
                        );

                    }

                }

            },

            x: {

                grid: {

                    display: false

                },

                ticks: {

                    font: {

                        size: 9

                    }

                }

            }

        }

    }

});

</script>


</body>

</html>