package com.expensemanager.service.impl;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.util.List;

import org.springframework.security.core.context.SecurityContextHolder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.expensemanager.dto.AddBudgetRequest;
import com.expensemanager.dto.ApiResponse;
import com.expensemanager.dto.BudgetResponse;
import com.expensemanager.dto.BudgetSummaryResponse;
import com.expensemanager.dto.UpdateBudgetRequest;
import com.expensemanager.entity.Budget;
import com.expensemanager.entity.User;
import com.expensemanager.enums.ExpenseCategory;
import com.expensemanager.exception.ResourceAlreadyExistsException;
import com.expensemanager.exception.ResourceNotFoundException;
import com.expensemanager.repository.BudgetRepository;
import com.expensemanager.repository.UserRepository;
import com.expensemanager.service.BudgetService;


@Service
@Transactional
public class BudgetServiceImpl
        implements BudgetService {

    private final BudgetRepository budgetRepository;
    private final UserRepository userRepository;

    public BudgetServiceImpl(
            BudgetRepository budgetRepository,
            UserRepository userRepository) {

        this.budgetRepository = budgetRepository;
        this.userRepository = userRepository;
    }

    // =====================================================
    // ADD BUDGET
    // =====================================================

    @Override
    public ApiResponse<BudgetResponse> addBudget(
            AddBudgetRequest request) {

        User user = getCurrentUser();

        boolean exists =
                budgetRepository
                        .findByUserAndCategoryAndMonthAndYear(
                                user,
                                request.getCategory(),
                                request.getMonth(),
                                request.getYear())
                        .isPresent();

        if (exists) {

            throw new ResourceAlreadyExistsException(
                    "Budget already exists for this category and month.");
        }

        Budget budget = new Budget();

        budget.setAmount(request.getAmount());
        budget.setCategory(request.getCategory());
        budget.setMonth(request.getMonth());
        budget.setYear(request.getYear());
        budget.setUser(user);

        Budget saved =
                budgetRepository.save(budget);

        return new ApiResponse<>(
                true,
                "Budget created successfully.",
                mapToResponse(saved));
    }

    // =====================================================
    // GET ALL
    // =====================================================

    @Override
    @Transactional(readOnly = true)
    public ApiResponse<List<BudgetResponse>>
            getAllBudgets() {

        User user = getCurrentUser();

        List<Budget> budgets =
                budgetRepository
                        .findAllByUserOrderByYearDescMonthDesc(
                                user);

        List<BudgetResponse> response =
                budgets.stream()
                        .map(this::mapToResponse)
                        .toList();

        return new ApiResponse<>(
                true,
                "Budgets fetched successfully.",
                response);
    }

    // =====================================================
    // GET BY MONTH
    // =====================================================

    @Override
    @Transactional(readOnly = true)
    public ApiResponse<List<BudgetResponse>>
            getBudgetsByMonth(
                    int month,
                    int year) {

        if (month < 1 || month > 12) {

            throw new IllegalArgumentException(
                    "Month must be between 1 and 12.");
        }

        User user = getCurrentUser();

        List<Budget> budgets =
                budgetRepository
                        .findAllByUserAndMonthAndYear(
                                user,
                                month,
                                year);

        List<BudgetResponse> response =
                budgets.stream()
                        .map(this::mapToResponse)
                        .toList();

        return new ApiResponse<>(
                true,
                "Monthly budgets fetched successfully.",
                response);
    }

    // =====================================================
    // GET BY ID
    // =====================================================

    @Override
    @Transactional(readOnly = true)
    public ApiResponse<BudgetResponse>
            getBudgetById(Long id) {

        User user = getCurrentUser();

        Budget budget =
                budgetRepository
                        .findByIdAndUser(id, user)
                        .orElseThrow(() ->
                                new ResourceNotFoundException(
                                        "Budget not found."));

        return new ApiResponse<>(
                true,
                "Budget fetched successfully.",
                mapToResponse(budget));
    }

    // =====================================================
    // UPDATE
    // =====================================================

    @Override
    public ApiResponse<BudgetResponse>
            updateBudget(
                    Long id,
                    UpdateBudgetRequest request) {

        User user = getCurrentUser();

        Budget budget =
                budgetRepository
                        .findByIdAndUser(id, user)
                        .orElseThrow(() ->
                                new ResourceNotFoundException(
                                        "Budget not found."));

        boolean duplicate =
                budgetRepository
                        .findByUserAndCategoryAndMonthAndYear(
                                user,
                                request.getCategory(),
                                request.getMonth(),
                                request.getYear())
                        .filter(existing ->
                                !existing.getId()
                                        .equals(id))
                        .isPresent();

        if (duplicate) {

            throw new ResourceAlreadyExistsException(
                    "Another budget already exists for this category and month.");
        }

        budget.setAmount(request.getAmount());
        budget.setCategory(request.getCategory());
        budget.setMonth(request.getMonth());
        budget.setYear(request.getYear());

        Budget updated =
                budgetRepository.save(budget);

        return new ApiResponse<>(
                true,
                "Budget updated successfully.",
                mapToResponse(updated));
    }

    // =====================================================
    // DELETE
    // =====================================================

    @Override
    public ApiResponse<Void> deleteBudget(
            Long id) {

        User user = getCurrentUser();

        Budget budget =
                budgetRepository
                        .findByIdAndUser(id, user)
                        .orElseThrow(() ->
                                new ResourceNotFoundException(
                                        "Budget not found."));

        budgetRepository.delete(budget);

        return new ApiResponse<>(
                true,
                "Budget deleted successfully.",
                null);
    }

    // =====================================================
    // CURRENT USER
    // =====================================================

    private User getCurrentUser() {

        String email =
                SecurityContextHolder
                        .getContext()
                        .getAuthentication()
                        .getName();

        return userRepository
                .findByEmail(email)
                .orElseThrow(() ->
                        new ResourceNotFoundException(
                                "User not found."));
    }

    // =====================================================
    // ENTITY → RESPONSE
    // =====================================================

    private BudgetResponse mapToResponse(
            Budget budget) {

        return new BudgetResponse(
                budget.getId(),
                budget.getAmount(),
                budget.getCategory(),
                budget.getMonth(),
                budget.getYear());
    }//end
    
    @Override
    @Transactional(readOnly = true)
    public ApiResponse<BudgetSummaryResponse> getBudgetSummary(
            Long id) {

        User user = getCurrentUser();

        Budget budget =
                budgetRepository
                        .findByIdAndUser(id, user)
                        .orElseThrow(() ->
                                new ResourceNotFoundException(
                                        "Budget not found."));

        /*
         * BudgetCategory and ExpenseCategory must represent
         * the same categories.
         *
         * We convert the budget category name to the
         * corresponding expense category.
         */
        ExpenseCategory expenseCategory;

        try {

            expenseCategory =
                    ExpenseCategory.valueOf(
                            budget.getCategory().name());

        } catch (IllegalArgumentException e) {

            throw new IllegalArgumentException(
                    "No matching expense category exists for budget category: "
                            + budget.getCategory());
        }

        BigDecimal spentAmount =
                expenseRepository
                        .getTotalSpentByCategoryAndMonth(
                                user,
                                expenseCategory,
                                budget.getMonth(),
                                budget.getYear());

        BigDecimal remainingAmount =
                budget.getAmount()
                        .subtract(spentAmount);

        BigDecimal usagePercentage;

        if (budget.getAmount()
                .compareTo(BigDecimal.ZERO) == 0) {

            usagePercentage = BigDecimal.ZERO;

        } else {

            usagePercentage =
                    spentAmount
                            .divide(
                                    budget.getAmount(),
                                    4,
                                    RoundingMode.HALF_UP)
                            .multiply(BigDecimal.valueOf(100))
                            .setScale(
                                    2,
                                    RoundingMode.HALF_UP);
        }

        boolean exceeded =
                spentAmount.compareTo(
                        budget.getAmount()) > 0;

        BudgetSummaryResponse response =
                new BudgetSummaryResponse(
                        budget.getId(),
                        budget.getCategory(),
                        budget.getAmount(),
                        spentAmount,
                        remainingAmount,
                        usagePercentage,
                        exceeded);

        return new ApiResponse<>(
                true,
                "Budget summary fetched successfully.",
                response);
    }
}